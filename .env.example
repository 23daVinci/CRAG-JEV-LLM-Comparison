# Copy to .env and fill in to run against live APIs. A fresh clone works without this file —
# `jev-bench bench --dry-run` uses two ScriptedDeciders and needs no keys at all.

GOOGLE_API_KEY=
TYPESAFE_API_KEY=

# Required for the default variant A backend (Groq, qwen/qwen3.8-27b) — see docs/METHODOLOGY.md
# for why Groq replaced Gemini and Ollama as the default. GOOGLE_API_KEY above is only needed if
# you explicitly switch variant A back to Gemini.
GROQ_API_KEY=
